{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nicotine-taper",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-13",
  "routes": [{ "pattern": "ciggs.knhdixh.com", "custom_domain": true }],
  "vars": { "CANONICAL_HOST": "ciggs.knhdixh.com" },
  // Keep the *.workers.dev address (it redirects to CANONICAL_HOST); per-version preview URLs aren't needed.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request hits the Worker first so *.workers.dev can redirect; it then serves static files.
    "run_worker_first": true
  }
}
